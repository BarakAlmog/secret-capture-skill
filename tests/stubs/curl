#!/usr/bin/env bash
# Test stub for curl as the coolify and n8n adapters call it: a fake Coolify and n8n
# holding state in $SC_TEST_DEST (a fake destination, fake values).
#   Coolify  POST|PATCH .../applications/<uuid>/envs   GET .../applications/<uuid>/envs
#   n8n      GET .../credentials?limit=..[&cursor=..]  POST .../credentials
#            PATCH .../credentials/<id> (isPartialData merges data)
# Each request is also recorded as $SC_TEST_DEST/http/<n>.{method,url,headers,body}.
#   SC_FAKE_HTTP_STATUS=<code>   every write answers <code>
#   SC_FAKE_COOLIFY_MANGLE=1     Coolify stores the value with a trailing space
# --fail on a status >= 400 exits 22 with curl's message.
set -euo pipefail
method=GET url="" out="" fail="" body_from="" headers=()
while (( $# > 0 )); do
  case "$1" in
    -sS|-s|-S) shift ;;
    --fail) fail=1; shift ;;
    -X) method="$2"; shift 2 ;;
    -H) headers+=("$2"); shift 2 ;;
    --data-binary) body_from="$2"; shift 2 ;;
    -o) out="$2"; shift 2 ;;
    -*) echo "curl stub: unsupported flag $1" >&2; exit 2 ;;
    *) url="$1"; shift ;;
  esac
done
dir="$SC_TEST_DEST/http"
mkdir -p "$dir"
n=$(find "$dir" -name '*.url' | wc -l | tr -d ' ')
printf '%s\n' "$method" > "$dir/$n.method"
printf '%s\n' "$url" > "$dir/$n.url"
for h in "${headers[@]}"; do
  if [[ "$h" == @* ]]; then cat "${h#@}"; else printf '%s\n' "$h"; fi
done > "$dir/$n.headers"
body=""
if [[ "$body_from" == @- ]]; then
  cat > "$dir/$n.body"
  body=$(<"$dir/$n.body")
fi

status=200
[[ "$method" != GET ]] && status="${SC_FAKE_HTTP_STATUS:-200}"
if (( status >= 400 )); then
  [[ -n "$fail" ]] && { echo "curl: (22) The requested URL returned error: $status" >&2; exit 22; }
  response='{"message":"error"}'
else
  path="${url#*://*/}"
  path="${path%%\?*}"
  case "$method $path" in
    "GET api/v1/applications/"*/envs)
      uuid="${path#api/v1/applications/}"; uuid="${uuid%/envs}"
      store="$SC_TEST_DEST/coolify-$uuid.json"
      response=$(cat "$store" 2>/dev/null || echo '[]')
      ;;
    "POST api/v1/applications/"*/envs|"PATCH api/v1/applications/"*/envs)
      uuid="${path#api/v1/applications/}"; uuid="${uuid%/envs}"
      store="$SC_TEST_DEST/coolify-$uuid.json"
      [[ -f "$store" ]] || echo '[]' > "$store"
      mangle=""; [[ -n "${SC_FAKE_COOLIFY_MANGLE:-}" ]] && mangle=" "
      next=$(jq --argjson b "$body" --arg m "$mangle" \
        '[.[] | select(.key != $b.key or .is_preview != $b.is_preview)] + [$b | .value += $m]' "$store")
      printf '%s\n' "$next" > "$store"
      response="$body"
      ;;
    "GET api/v1/credentials")
      store="$SC_TEST_DEST/n8n.json"
      response=$(jq -c '{data: [.[] | {id, name, type}], nextCursor: null}' "$store" 2>/dev/null || echo '{"data":[],"nextCursor":null}')
      ;;
    "POST api/v1/credentials")
      store="$SC_TEST_DEST/n8n.json"
      [[ -f "$store" ]] || echo '[]' > "$store"
      id="cred-$(jq length "$store")"
      next=$(jq --argjson b "$body" --arg id "$id" '. + [$b + {id: $id}]' "$store")
      printf '%s\n' "$next" > "$store"
      response=$(jq -nc --arg id "$id" --argjson b "$body" '{id: $id, name: $b.name, type: $b.type}')
      ;;
    "PATCH api/v1/credentials/"*)
      store="$SC_TEST_DEST/n8n.json"
      id="${path#api/v1/credentials/}"
      next=$(jq --argjson b "$body" --arg id "$id" \
        'map(if .id == $id then .data = (if $b.isPartialData then .data + $b.data else $b.data end) else . end)' "$store")
      printf '%s\n' "$next" > "$store"
      response=$(jq -c --arg id "$id" '.[] | select(.id == $id) | {id, name, type}' "$store")
      ;;
    *) echo "curl stub: no route for $method $url" >&2; exit 2 ;;
  esac
fi
if [[ -n "$out" ]]; then printf '%s' "$response" > "$out"; else printf '%s' "$response"; fi
