#!/usr/bin/env bash
# Test stub for ssh: runs the remote command in a local shell (the "remote host" is the
# test's directory tree). Skips -o <opt> and -T, takes the first other word as the host.
set -euo pipefail
while (( $# > 0 )); do
  case "$1" in
    -o) shift 2 ;;
    -T) shift ;;
    *) break ;;
  esac
done
shift   # host
exec sh -c "$*"
